FROM ghcr.io/cirruslabs/android-sdk:35 AS build

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl imagemagick \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .

RUN npm run build \
    && npx cap add android \
    && npx cap sync android \
    && sed -i 's/versionName "[^"]*"/versionName "1.0.0"/' android/app/build.gradle \
    && sed -i 's/versionCode [0-9][0-9]*/versionCode 1/' android/app/build.gradle \
    && rm -f android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml android/app/src/main/res/mipmap-anydpi-v26/ic_launcher_round.xml \
    && for spec in mdpi:48 hdpi:72 xhdpi:96 xxhdpi:144 xxxhdpi:192; do \
         density="${spec%%:*}"; size="${spec##*:}"; \
         mkdir -p "android/app/src/main/res/mipmap-${density}"; \
         convert public/icon-512.webp -resize "${size}x${size}" "android/app/src/main/res/mipmap-${density}/ic_launcher.png"; \
         convert public/icon-512.webp -resize "${size}x${size}" "android/app/src/main/res/mipmap-${density}/ic_launcher_round.png"; \
       done \
    && chmod +x android/gradlew \
    && cd android \
    && ./gradlew assembleRelease --no-daemon

FROM ghcr.io/cirruslabs/android-sdk:35

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY --from=build /src/android/app/build/outputs/apk/release/app-release-unsigned.apk /srv/app-release-unsigned.apk
COPY railway-android-start.sh /usr/local/bin/matloob-start
RUN chmod +x /usr/local/bin/matloob-start

ENV PORT=8080
EXPOSE 8080
CMD ["/usr/local/bin/matloob-start"]
